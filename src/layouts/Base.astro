---
// Gabarit commun à toutes les pages publiques : en-tête, menu, pied de page, cookies.
import { reglages, urlSite, couleur, typo } from '../lib/site.js';

const { titre, description = '', image, ld, noindex = false, classeCorps = '', accueil = false } = Astro.props;
const r = await reglages();
const site = urlSite();
const chemin = Astro.url.pathname;
const titreComplet = !titre || titre === r.nom ? r.nom : `${titre} | ${r.nom}`;
const partage = image?.src ? image : r.image_partage;
const absolu = (u) => (u && !/^https?:/.test(u) ? site + u : u);

const menu = [
	['/qui-sommes-nous/', 'Qui sommes-nous ?'],
	['/ateliers/', 'Ateliers'],
	['/calendrier/', 'Calendrier'],
	['/actualites/', 'Actualités'],
	['/livre-or/', 'Témoignages'],
];
// Photo montrée à droite du menu plein écran quand on survole chaque page
const apercusMenu = ['/images/conference-800.webp', '/images/echeveaux-teints-800.webp', '/images/atelier-plein-air-800.webp', '/images/panier-echeveaux-800.webp', '/images/enfant-tissage-carton-800.webp', '/images/metier-a-tisser-vertical-800.webp'];
const menuComplet = [...menu, ['/contact/', 'Contact']];
const pied = [
	['/contact/', 'Contact'],
	['/mentions-legales/', 'Mentions légales'],
	['/politique-de-confidentialite/', 'Politique de confidentialité'],
	['/politique-cookies/', 'Politique de cookies'],
];
const actif = (url) => chemin === url || (url !== '/' && chemin.startsWith(url));

const organisation = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	'@id': site + '/#organization',
	name: r.nom,
	url: site + '/',
	email: r.email,
	logo: site + '/images/logo-neotisse.png',
	address: { '@type': 'PostalAddress', streetAddress: r.adresse?.split(',')[0], postalCode: '34090', addressLocality: 'Montpellier', addressCountry: 'FR' },
	sameAs: [r.facebook, r.instagram].filter(Boolean),
};
const annee = new Date().getFullYear();
const ga = (r.ga_id || '').trim().match(/^G-[A-Z0-9]+$/i) ? r.ga_id.trim() : '';
---
<!doctype html>
<html lang="fr">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{titreComplet}</title>
	{description && <meta name="description" content={description} />}
	<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
	<link rel="canonical" href={site + chemin} />
	<link rel="icon" href="/images/logo-neotisse.png" type="image/png" />
	<meta property="og:locale" content="fr_FR" />
	<meta property="og:type" content={chemin === '/' ? 'website' : 'article'} />
	<meta property="og:site_name" content={r.nom} />
	<meta property="og:title" content={titreComplet} />
	{description && <meta property="og:description" content={description} />}
	<meta property="og:url" content={site + chemin} />
	{partage?.src && <meta property="og:image" content={absolu(partage.src)} />}
	{partage?.alt && <meta property="og:image:alt" content={partage.alt} />}
	<meta name="twitter:card" content="summary_large_image" />
	<link rel="preload" href="/fonts/fraunces-latin-300-normal.woff2" as="font" type="font/woff2" crossorigin />
	<link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
	{accueil ? (
		<Fragment>
			<link rel="stylesheet" href="/css/v2-commun.css" />
			<link rel="stylesheet" href="/css/v2-accueil.css" />
		</Fragment>
	) : (
		<Fragment>
			<link rel="stylesheet" href="/css/base-avant.css" />
			<link rel="stylesheet" href="/css/style.css" />
			<link rel="stylesheet" href="/css/base-apres.css" />
			<link rel="stylesheet" href="/css/ajouts.css" />
			<link rel="stylesheet" href="/css/v2-commun.css" />
		</Fragment>
	)}
	<script is:inline set:html={`(function(){var h=document.documentElement;try{if(sessionStorage.getItem('neo-transition'))h.classList.add('arrivee');${accueil ? "if(!sessionStorage.getItem('neo-vu')){h.classList.add('premiere-visite');sessionStorage.setItem('neo-vu','1');}" : ''}}catch(e){}if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){h.classList.remove('arrivee','premiere-visite');}})();`} />
	<style is:inline set:html={r.categories.map((c) => `.t-${c.cle}{--c:${couleur(c.couleur)}}`).join('')}></style>
	<script type="application/ld+json" set:html={JSON.stringify(organisation)} />
	{ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
	<slot name="tete" />
</head>
<body class={accueil ? 'accueil' : `boutons-garance interieur ${classeCorps}`}>
	<a class="saut" href="#contenu">Aller au contenu</a>
	<div class="avancee" id="avancee" aria-hidden="true"></div>
	{accueil && (
		<Fragment>
			<div class="chargement" id="chargement" aria-hidden="true">
				<div class="ch-moitie ch-haut" id="ch-haut"><div class="ch-nom" id="ch-nom">{r.nom.toUpperCase().split('').map((c) => <span class="l"><span>{c}</span></span>)}</div></div>
				<div class="ch-moitie ch-bas" id="ch-bas"><p class="ch-petit" id="ch-petit">Ateliers textiles anciens · Montpellier</p></div>
				<svg class="ch-trace" id="ch-trace">
					<defs><clipPath id="ch-boule"><circle r="64"></circle></clipPath></defs>
					<path id="ch-fil" fill="none" stroke="#E8B42F" stroke-linecap="round"></path>
					<g id="ch-pelote" opacity="0"><g id="ch-ecrase"><g id="ch-taille"><g id="ch-roule">
						<circle r="64" fill="#E8B42F"></circle>
						<g clip-path="url(#ch-boule)" fill="none" stroke-linecap="round">
							<g stroke="#B3841A" stroke-width="5"><ellipse rx="62" ry="22" transform="rotate(-35)"></ellipse><ellipse rx="62" ry="38" transform="rotate(-35)"></ellipse><ellipse rx="62" ry="54" transform="rotate(-35)"></ellipse><ellipse rx="20" ry="62" transform="rotate(30)"></ellipse><ellipse rx="40" ry="62" transform="rotate(30)"></ellipse></g>
							<g stroke="#F3CF6E" stroke-width="4" opacity=".9"><ellipse rx="62" ry="30" transform="rotate(-35)"></ellipse><ellipse rx="62" ry="46" transform="rotate(-35)"></ellipse><ellipse rx="30" ry="62" transform="rotate(30)"></ellipse><ellipse rx="52" ry="62" transform="rotate(30)"></ellipse></g>
							<circle r="64" fill="none" stroke="#B3841A" stroke-width="10" opacity=".35"></circle>
						</g>
					</g></g></g></g>
				</svg>
			</div>
			<button class="ch-passer" id="ch-passer" type="button">Passer l'introduction</button>
		</Fragment>
	)}
	<header class:list={['tete env', { plein: !accueil }]} id="tete">
		<div class="l">
			<button class="menu-btn" type="button" id="ouvrir-menu" aria-expanded="false" aria-controls="menu-plein"><span class="barres" aria-hidden="true"><i></i><i></i></span><span class="mot" aria-hidden="true">Menu</span><span class="sr">Ouvrir le menu</span></button>
			<a class="marque" href="/" aria-label={`${r.nom}, accueil`} aria-current={chemin === '/' ? 'page' : undefined}><img src="/images/logo-neotisse.png" alt="" width="34" height="29" />{r.nom.toUpperCase()}</a>
			<div class="tete-droite"><a class="bouton" href="/contact/" data-page="Contact"><span class="long">Demander un&nbsp;</span>devis</a></div>
		</div>
	</header>
	<div class="menu-plein" id="menu-plein" role="dialog" aria-modal="true" aria-label="Menu" hidden>
		<button class="fermer" type="button" id="fermer-menu"><span aria-hidden="true">✕</span> Fermer</button>
		<nav aria-label="Pages du site">
			<ul>
				{menuComplet.map(([url, nom], i) => (
					<li><a href={url} data-page={nom} data-img={i} aria-current={actif(url) ? 'page' : undefined}><small aria-hidden="true">{String(i + 1).padStart(2, '0')}</small><span class="mot">{typo(nom)}</span></a></li>
				))}
			</ul>
			<div class="bas">
				<span>{r.email}</span>
				{r.facebook && <a href={r.facebook} target="_blank" rel="noopener">Facebook<span class="sr"> (nouvel onglet)</span></a>}
				{r.instagram && <a href={r.instagram} target="_blank" rel="noopener">Instagram<span class="sr"> (nouvel onglet)</span></a>}
				<span>Montpellier</span>
			</div>
		</nav>
		<div class="apercu" aria-hidden="true">
			{apercusMenu.map((src, i) => <img src={src} alt="" class={i === 0 ? 'vu' : undefined} loading="lazy" />)}
		</div>
	</div>

	<main id="contenu">
		<slot />
	</main>

	<footer class="pied env">
		<div class="l">
			<div>
				<p class="grand">Faire vivre les savoir-faire textiles du passé.</p>
				<p class="presentation">{r.description_pied}</p>
				<div class="reseaux">
					{r.facebook && <a href={r.facebook} target="_blank" rel="noopener">Facebook<span class="sr"> (nouvel onglet)</span></a>}
					{r.instagram && <a href={r.instagram} target="_blank" rel="noopener">Instagram<span class="sr"> (nouvel onglet)</span></a>}
				</div>
			</div>
			<nav aria-label="Pages du site"><ul>{menu.map(([url, nom]) => <li><a href={url}>{nom}</a></li>)}</ul></nav>
			<nav aria-label="Informations"><ul>
				<li>{r.email}</li>
				{pied.map(([url, nom]) => <li><a href={url}>{nom}</a></li>)}
				<li><button type="button" class="lien-cookies" data-neo-cookies="ouvrir">Gérer mes cookies</button></li>
			</ul></nav>
			<p class="mention"><span>© {annee} {r.nom} · Association loi 1901 · Montpellier</span><span>Site conçu par BELLADONNA</span></p>
		</div>
	</footer>

	<div class="flottant" id="flottant"><a class="bouton" href="/contact/" data-page="Contact">Demander un devis <span class="f" aria-hidden="true">→</span></a></div>
	<div class="rideau" id="rideau" aria-hidden="true"><span style="background:#4F5233"></span><span style="background:#A8321F"></span><span style="background:#E8B42F"></span><span style="background:#2E5A8A"></span><div class="nom" id="rideau-nom"></div></div>

	<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

	{r.bandeau_cookies !== false && (
		<Fragment>
			<div class="cookies-fond" id="neo-cookies-fond" hidden></div>
			<div class="cookies" id="neo-cookies" role="dialog" aria-modal="true" aria-labelledby="neo-cookies-titre" aria-describedby="neo-cookies-texte" data-auto={chemin.startsWith('/politique-cookies') ? '0' : '1'} hidden>
				<p class="cookies-titre" id="neo-cookies-titre">Vos choix de cookies</p>
				<p class="cookies-texte" id="neo-cookies-texte">
					Nous aimerions mesurer la fréquentation du site{ga ? ' avec Google Analytics' : ''} pour l'améliorer. Ces cookies ne sont déposés que si vous les acceptez. Vous pouvez changer d'avis à tout moment.
					<a href="/politique-cookies/">Politique de cookies</a>
				</p>
				<div class="cookies-details" id="neo-cookies-details" hidden>
					<div class="cookies-ligne">
						<div><p class="cookies-cat">Nécessaires</p><p>Mémoriser vos choix de cookies. Toujours actifs.</p></div>
						<span class="cookies-toujours">Toujours actifs</span>
					</div>
					<div class="cookies-ligne">
						<div><p class="cookies-cat"><label for="neo-c-audience">Mesure d'audience</label></p><p>Compter les visites, les pages consultées et d'où viennent les visiteurs (Google Analytics).</p></div>
						<input type="checkbox" id="neo-c-audience" class="cookies-switch" />
					</div>
				</div>
				<div class="cookies-btns">
					<button type="button" class="btn cookies-btn" data-neo-cookies="refuser">Tout refuser</button>
					<button type="button" class="btn cookies-btn" data-neo-cookies="accepter">Tout accepter</button>
					<button type="button" class="cookies-lien" data-neo-cookies="personnaliser" aria-expanded="false" aria-controls="neo-cookies-details">Personnaliser</button>
					<button type="button" class="btn cookies-btn" data-neo-cookies="enregistrer" hidden>Enregistrer mes choix</button>
				</div>
			</div>
		</Fragment>
	)}

	{ga && (
		<Fragment>
			<script type="text/plain" data-neo-consent="audience" async src={`https://www.googletagmanager.com/gtag/js?id=${ga}`}></script>
			<script type="text/plain" data-neo-consent="audience" set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config',${JSON.stringify(ga)},{anonymize_ip:true});`}></script>
		</Fragment>
	)}
	<script is:inline src="/js/cookies.js" defer></script>
	<script is:inline src="/js/site.js" defer></script>
	<script>import '../scripts/commun.js';</script>
	{!accueil && <script>import '../scripts/defilement.js';</script>}
</body>
</html>
