---
import Admin from '../../../layouts/Admin.astro';
import Sections from '../../../components/admin/Sections.astro';
import { PAGES } from '../../../lib/schemas.js';
import { page } from '../../../lib/site.js';
import { lire, ecrire } from '../../../lib/donnees.js';
import { formulaireEnObjet, convertir, sourcesAdmin } from '../../../lib/admin.js';

const cle = Astro.params.cle;
const def = PAGES[cle];
if (!def) return Astro.redirect('/admin/pages/');

if (Astro.request.method === 'POST') {
	const brut = formulaireEnObjet(await Astro.request.formData());
	const avant = (await lire('pages', cle)) || {};
	const data = { ...avant };
	for (const s of def.sections) {
		if (s.cle) data[s.cle] = { ...(avant[s.cle] || {}), ...convertir(s.champs, brut[s.cle] || {}) };
		else Object.assign(data, convertir(s.champs, brut));
	}
	try {
		await ecrire('pages', cle, data);
		return Astro.redirect(`/admin/pages/${cle}/?ok=` + encodeURIComponent(`Page « ${def.nom} » enregistrée. Les changements sont déjà en ligne.`), 303);
	} catch (e) {
		return Astro.redirect(`/admin/pages/${cle}/?erreur=` + encodeURIComponent(e.message), 303);
	}
}
const [valeurs, sources] = await Promise.all([page(cle), sourcesAdmin()]);
---
<Admin titre={def.nom} actif="pages">
	<div class="adm-titre">
		<div>
			<a class="adm-fil" href="/admin/pages/">← Toutes les pages</a>
			<h1>{def.nom}</h1>
			{def.note && <p>{def.note}</p>}
		</div>
		<a class="b b-second" href={def.url} target="_blank" rel="noopener">Voir la page ↗</a>
	</div>
	<form method="post" class="edition">
		<Sections sections={def.sections} valeurs={valeurs} sources={sources} />
		<div class="barre-enregistrer">
			<button class="b b-principal" type="submit">Enregistrer</button>
			<a class="b b-second" href={def.url} target="_blank" rel="noopener">Voir la page ↗</a>
			<span class="modifie" data-etat-modif></span>
		</div>
	</form>
</Admin>
