---
// Questions fréquentes (dépliables) + données structurées pour Google.
import Groupe from './Groupe.astro';
import Image from './Image.astro';
import { affiche, brut } from '../lib/html.js';
import { typo } from '../lib/site.js';
const { faq } = Astro.props;
const questions = (faq?.questions || []).filter((q) => q.question && q.reponse);
const ld = questions.length && {
	'@context': 'https://schema.org', '@type': 'FAQPage',
	mainEntity: questions.map((q) => ({ '@type': 'Question', name: q.question, acceptedAnswer: { '@type': 'Answer', text: brut(q.reponse) } })),
};
---
{questions.length > 0 && (
	<Groupe classe="sec faq-zone">
		<Groupe classe="wrap stack faq">
			<Image image={faq.photo} classe="faq-photo" />
			<h2 class="wp-block-heading h2" id="faq">{typo(faq.titre)}</h2>
			{questions.map((q) => (
				<details class="wp-block-details faq-q is-layout-flow wp-block-details-is-layout-flow">
					<summary>{typo(q.question)}</summary>
					<Fragment set:html={affiche(q.reponse).replace(/<p>/g, '<p class="wp-block-paragraph">')} />
				</details>
			))}
		</Groupe>
	</Groupe>
)}
{ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
