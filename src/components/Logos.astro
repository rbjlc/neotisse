---
// Logos (ou noms) des partenaires.
import { esc, lienSur } from '../lib/html.js';
const { partenaires, classe = 'logos' } = Astro.props;
---
{partenaires.length > 0 && (
	<ul class={classe} role="list">
		{partenaires.map((p) => {
			const contenu = p.logo?.src
				? `<img src="${esc(lienSur(p.logo.src))}" alt="${esc(p.nom)}" loading="lazy">`
				: `<span class="logo-nom">${esc(p.nom)}</span>`;
			return (
				<li class="logo-item">
					{lienSur(p.lien)
						? <a href={lienSur(p.lien)} target="_blank" rel="noopener" set:html={contenu} />
						: <Fragment set:html={contenu} />}
				</li>
			);
		})}
	</ul>
)}
