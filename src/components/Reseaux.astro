---
// Liens Facebook et Instagram (pied de page, contact, actualités).
const { r, classe = 'reseaux' } = Astro.props;
---
{(r.facebook || r.instagram) && (
	<div class={classe}>
		{r.facebook && (
			<a class="reseau" href={r.facebook} target="_blank" rel="noopener">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.8 1.4-3.8 3.9v2.3H8v3h2.5V21h3z"></path></svg>
				<span>Facebook</span><span class="screen-reader-text"> (nouvel onglet)</span>
			</a>
		)}
		{r.instagram && (
			<a class="reseau" href={r.instagram} target="_blank" rel="noopener">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"></rect><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle><circle cx="17.3" cy="6.7" r="1.2" fill="currentColor"></circle></svg>
				<span>Instagram</span><span class="screen-reader-text"> (nouvel onglet)</span>
			</a>
		)}
	</div>
)}
