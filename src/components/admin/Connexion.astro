---
// Petit gabarit pour les pages de connexion (sans menu).
const { titre } = Astro.props;
---
<!doctype html>
<html lang="fr">
<head>
	<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex, nofollow" />
	<title>{titre} · Espace Neotisse</title>
	<link rel="icon" href="/images/logo-neotisse.png" type="image/png" />
	<link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="adm">
	<main class="connexion">
		<div class="carte">
			<h1><img src="/images/logo-neotisse.png" alt="" width="44" height="38" /> {titre}</h1>
			<slot />
		</div>
	</main>
	<script is:inline src="/js/admin.js" defer></script>
</body>
</html>
